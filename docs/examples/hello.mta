; hello.mta - minimal end-to-end example: print a string constant
.module "hello"
.string msg "hello, mote"
.import print_str 2
.import const_addr 1
.import const_len 1

.func main 0 8
    llo r0, 0
    hostcall r1, const_addr
    llo r0, 0
    hostcall r2, const_len
    mov r0, r1
    mov r1, r2
    hostcall r3, print_str
    llo r0, 0
    ret r0
.end
